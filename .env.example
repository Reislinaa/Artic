# =========================================================
# ARTIC · 后端环境变量模板
# 复制为 .env 后填写真实值（.env 已被 git 忽略，不会上传）
#   复制命令：copy .env.example .env
#
# 通用原则：**未配置的功能不会报错，只会降级**
#   · 支付未配置  → 演示模式（流程可完整预览）
#   · 登录渠道未配置 → 登录弹窗显示为不可点的「预留入口」
#   填入凭据后自动启用，无需改动任何代码。
# =========================================================

# ---- 通用 ----
PORT=3001
# 站点对外地址（生成支付回调 / 登录回跳地址用，生产必填）
SITE_URL=https://your-domain.example

# =========================================================
# 会话与账号
# =========================================================
# 会话签名密钥（**生产必填**，泄漏等于可伪造登录态）
# 生成： node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# =========================================================
# 第三方登录（预留式：填入凭据后，登录弹窗对应按钮自动可点）
# 各渠道都需要在平台上登记「回调地址」，格式统一为：
#   https://你的域名/api/auth/<渠道id>/callback
#   例： https://your-domain.example/api/auth/wechat/callback
# =========================================================

# ---- 微信开放平台「网站应用」（扫码登录）----
# open.weixin.qq.com → 管理中心 → 网站应用（需企业资质，审核约 1~7 天）
# 注意：与「微信支付」所用的 AppID **不是同一个**，勿混用
WECHAT_OPEN_APPID=
WECHAT_OPEN_SECRET=

# ---- QQ 互联 ----
# connect.qq.com → 创建网站应用，获取 APP ID / APP Key
QQ_APP_ID=
QQ_APP_KEY=

# ---- 飞书开放平台（网页应用）----
# open.feishu.cn → 创建企业自建应用 → 开通「获取用户身份信息」权限
# FEISHU_DOMAIN=lark 可切换到国际版 Lark（open.larksuite.com）
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_DOMAIN=feishu

# ---- 钉钉开放平台 ----
# open-dev.dingtalk.com → 创建应用 → 开通「个人信息读取」权限
# 这里填的是 AppKey / AppSecret
DINGTALK_CLIENT_ID=
DINGTALK_CLIENT_SECRET=

# 预留未对接（代码已留占位入口，接入时按 server/oauth.js 里同样的结构补一条即可）：
#   企业微信 / 支付宝 / GitHub / Google / Apple

# =========================================================
# 微信支付 Native（PC 网站扫码）
# 申请入口：pay.weixin.qq.com「接入微信支付」注册商户号
# 前提：已认证的小程序或服务号（提供 AppID）
# =========================================================
# 【商户号 mchid】商户平台首页可见
WECHAT_MCHID=
# 【AppID】已认证小程序/服务号（mp.weixin.qq.com）
WECHAT_APPID=
# 【APIv3 密钥】商户平台 → 账户中心 → API安全 → 设置APIv3密钥（32位）
WECHAT_APIV3_KEY=
# 【商户证书序列号】商户平台 → API安全 → 查看证书
WECHAT_SERIAL_NO=
# 【商户API私钥】API安全 → 下载证书 → 解压得 apiclient_key.pem
# 放到 server/certs/ 目录，此处填相对路径
WECHAT_PRIVATE_KEY_PATH=./server/certs/apiclient_key.pem
# 【商户证书】同上解压得 apiclient_cert.pem
WECHAT_PUBLIC_KEY_PATH=./server/certs/apiclient_cert.pem
# 【微信支付平台证书】（强烈建议配置，用于回调验签）
# 商户平台 → API安全 → 平台证书，下载后填路径；不配置则回调仅解密不验签
WECHAT_PLATFORM_CERT_PATH=./server/certs/wechatpay_platform_cert.pem
# 【支付结果通知地址】必须公网 HTTPS，指向本服务
WECHAT_NOTIFY_URL=https://your-domain.example/api/pay/wechat/notify

# =========================================================
# 支付宝 当面付（扫码）
# 申请入口：open.alipay.com 开放平台 → 创建应用 → 签约「当面付」
# =========================================================
# 【应用 APPID】开放平台 → 应用详情 → 概览
ALIPAY_APP_ID=
# 【应用私钥】开放平台 → 开发设置 → 密钥管理 → 生成 RSA2 密钥对，
# 保存为 server/certs/alipay-app-private.pem 后填路径
ALIPAY_PRIVATE_KEY_PATH=./server/certs/alipay-app-private.pem
# 【支付宝公钥】开放平台 → 密钥管理 → 查看支付宝公钥（粘贴单行）
ALIPAY_PUBLIC_KEY=
# 【异步通知地址】公网 HTTPS，指向本服务
ALIPAY_NOTIFY_URL=https://your-domain.example/api/pay/alipay/notify

# =========================================================
# 部署
# =========================================================
# 由 Express 同时托管构建产物与 API，生产环境设为 production
NODE_ENV=production
