# =========================================================
# ARTIC · 后端环境变量模板
# 复制为 .env 后填写真实值（.env 已被 git 忽略，不会上传）
#   复制命令：copy .env.example .env
#
# 重要：未填写时系统运行在「演示模式」——前端页面与支付流程可完整预览；
#       填齐某个渠道后，该渠道自动切换为「正式收款」，无需改动任何代码。
#       启动服务时会打印当前模式与仍缺失的字段。
# =========================================================

# ---- 通用 ----
PORT=3001
# 站点对外地址（用于生成前端跳转链接，生产必填）
SITE_URL=https://your-domain.example

# =========================================================
# 微信支付 Native（PC 网站扫码）
# 申请入口：pay.weixin.qq.com「接入微信支付」注册商户号
# 前提：已认证的小程序或服务号（提供 AppID）
# =========================================================
# 【商户号 mchid】商户平台首页可见
WECHAT_MCHID=
# 【AppID】已认证小程序/服务号（mp.weixin.qq.com）
WECHAT_APPID=
# 【APIv3 密钥】商户平台 → 账户中心 → API安全 → 设置APIv3密钥（32位）
WECHAT_APIV3_KEY=
# 【商户证书序列号】商户平台 → API安全 → 查看证书
WECHAT_SERIAL_NO=
# 【商户API私钥】API安全 → 下载证书 → 解压得 apiclient_key.pem
# 放到 server/certs/ 目录，此处填相对路径
WECHAT_PRIVATE_KEY_PATH=./server/certs/apiclient_key.pem
# 【商户证书】同上解压得 apiclient_cert.pem
WECHAT_PUBLIC_KEY_PATH=./server/certs/apiclient_cert.pem
# 【微信支付平台证书】（强烈建议配置，用于回调验签）
# 商户平台 → API安全 → 平台证书，下载后填路径；不配置则回调仅解密不验签
WECHAT_PLATFORM_CERT_PATH=./server/certs/wechatpay_platform_cert.pem
# 【支付结果通知地址】必须公网 HTTPS，指向本服务
WECHAT_NOTIFY_URL=https://your-domain.example/api/pay/wechat/notify

# =========================================================
# 支付宝 当面付（扫码）
# 申请入口：open.alipay.com 开放平台 → 创建应用 → 签约「当面付」
# =========================================================
# 【应用 APPID】开放平台 → 应用详情 → 概览
ALIPAY_APP_ID=
# 【应用私钥】开放平台 → 开发设置 → 密钥管理 → 生成 RSA2 密钥对，
# 保存为 server/certs/alipay-app-private.pem 后填路径
ALIPAY_PRIVATE_KEY_PATH=./server/certs/alipay-app-private.pem
# 【支付宝公钥】开放平台 → 密钥管理 → 查看支付宝公钥（粘贴单行）
ALIPAY_PUBLIC_KEY=
# 【异步通知地址】公网 HTTPS，指向本服务
ALIPAY_NOTIFY_URL=https://your-domain.example/api/pay/alipay/notify

# =========================================================
# 部署
# =========================================================
# 由 Express 同时托管构建产物与 API，生产环境设为 production
NODE_ENV=production
