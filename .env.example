# =========================================================
# 流星语 · 后端环境变量模板
# 复制为 .env 后填写真实值（.env 已被 git 忽略，不会上传）
#   复制命令：copy .env.example .env
# 获取位置已用【】标注，照着去对应平台申请即可
# =========================================================

# ---- 通用 ----
# 后端端口（部署到服务器后可改成 3001 或由托管平台注入）
PORT=3001
# 站点对外地址（用于生成支付回调/前端跳转链接，生产必填）
SITE_URL=https://your-domain.example

# =========================================================
# 微信支付 Native（扫码支付）
# 申请入口：pay.weixin.qq.com「接入微信支付」注册商户号
# 前提：已认证的小程序或服务号（提供 AppID）
# =========================================================
# 【商户号 mchid】商户平台首页可见
WECHAT_MCHID=
# 【AppID】已认证小程序/服务号（微信公众平台 mp.weixin.qq.com）
WECHAT_APPID=
# 【APIv3 密钥】商户平台 → 账户中心 → API安全 → 设置APIv3密钥（32位）
WECHAT_APIV3_KEY=
# 【商户证书序列号】商户平台 → API安全 → 查看证书，形如 1234567890ABCDEF...
WECHAT_SERIAL_NO=
# 【商户API私钥文件】商户平台 → API安全 → 下载证书，解压得到 apiclient_key.pem，
# 放到本项目 server/certs/ 目录（该目录不入库），这里填路径
WECHAT_PRIVATE_KEY_PATH=./server/certs/apiclient_key.pem
# 【支付回调地址】必须是公网 HTTPS，指向本服务；需要真实 IP 访问，不能是 localhost
WECHAT_NOTIFY_URL=https://your-domain.example/api/pay/wechat/notify

# =========================================================
# 支付宝 当面付（扫码） / 电脑网站支付
# 申请入口：open.alipay.com 开放平台 → 创建应用（网页/移动应用）
#           → 签约「当面付」/「电脑网站支付」产品
# =========================================================
# 【应用 APPID】开放平台 → 应用详情 → 概览
ALIPAY_APP_ID=
# 【应用私钥文件】开放平台 → 开发设置 → 密钥管理 → 生成应用私钥（RSA2），
# 保存为 server/certs/alipay-app-private.pem 后填路径
ALIPAY_PRIVATE_KEY_PATH=./server/certs/alipay-app-private.pem
# 【支付宝公钥】开放平台 → 开发设置 → 密钥管理 → 查看支付宝公钥（粘贴单行）
ALIPAY_PUBLIC_KEY=
# 【回调地址】公网 HTTPS，指向本服务
ALIPAY_NOTIFY_URL=https://your-domain.example/api/pay/alipay/notify

# =========================================================
# 部署（生产环境）
# =========================================================
# 由 Express 托管构建产物并开启支付路由，改为 production
NODE_ENV=production
